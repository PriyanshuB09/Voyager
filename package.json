{
  "name": "csp-voyager",
  "version": "3.4.0",
  "author": "Priyanshu Biswal",
  "description": "An open-source FIRST Robotics Competition autonomous builder dashboard. Promotes modularity and branching, as well visual graphs and support for object detection deviances.",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "capture:ui": "electron scripts/capture-ui.mjs",
    "test:smoke": "electron scripts/smoke-ui.mjs",
    "test:audit": "electron scripts/audit-ui.mjs",
    "test:stacking": "electron scripts/test-focus-stacking.mjs",
    "test:persistence": "electron scripts/test-persistence.mjs",
    "test:performance": "electron scripts/benchmark-ui.mjs",
    "test:telemetry": "electron scripts/test-telemetry.mjs",
    "package:win": "npm run build && electron-builder --win --publish never",
    "release": "npm run package:win",
    "release:dir": "electron-vite build && electron-builder --win --dir",
    "dist": "npm run package:win"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@frc-web-components/fwc": "^3.2.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.24",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.28.0",
    "postcss": "^8.5.25",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "ws": "^8.21.0"
  },
  "build": {
    "appId": "com.team4188.voyager",
    "productName": "Voyager",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "electron/Group 1.png",
        "to": "icon.png"
      }
    ],
    "win": {
      "icon": "electron/Group 1.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icons/256x256.png"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PriyanshuB09/Voyager.git"
  },
  "keywords": [],
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/PriyanshuB09/Voyager/issues"
  },
  "homepage": "https://github.com/PriyanshuB09/Voyager#readme"
}
